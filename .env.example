# ---- Ably ----
ABLY_API_KEY=your_app_id.your_key_id:your_key_secret

# ---- Vercel Postgres ----
# Auto-populated when you connect a Vercel Postgres database to this
# project (Storage tab -> Create Database -> Connect Project).
POSTGRES_PRISMA_URL=postgres://...
POSTGRES_URL_NON_POOLING=postgres://...

# ---- Auth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_random_32_byte_secret
NEXTAUTH_URL=http://localhost:3000

# ---- Email (Resend) ----
# Sign up at https://resend.com, create an API key. The free tier is
# plenty to start. Verify your own domain there before setting EMAIL_FROM
# to an address on it — until then "onboarding@resend.dev" works for testing.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM="RoboArm <onboarding@resend.dev>"

# Base URL used to build links inside verification/reset emails.
APP_URL=http://localhost:3000
