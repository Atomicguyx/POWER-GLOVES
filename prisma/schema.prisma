generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // These two env vars are auto-populated when you connect a Vercel
  // Postgres database to this project (Storage tab -> Connect Project).
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  USER
  ADMIN
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  devices       Device[]
}

model Device {
  id          String    @id @default(cuid())
  // The serial number flashed into the firmware / printed on the unit,
  // and pre-created in bulk by admins before a device ever ships.
  // This is also used to build the Ably channel name: `glove-<serial>`.
  serial      String    @unique
  name        String?
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id])
  calibration Json?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
}

model VerificationToken {
  id        String       @id @default(cuid())
  token     String       @unique
  email     String
  purpose   TokenPurpose
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([email, purpose])
}
